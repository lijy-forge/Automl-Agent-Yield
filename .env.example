USE_OPENAI_PARSER=true
PARSER_LLM=ark
DEFAULT_LLM=ark

OPENAI_KEY=

# External search providers. Strict yield runs stop if all external providers
# return no usable results.
SEARCH_PROVIDER=auto
SEARCHAPI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=
CROSSREF_MAILTO=

# OpenAI-compatible custom gateway.
# Use the /v1 base URL with the OpenAI Python SDK. Do not include /chat/completions here.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://z.apiyihe.org/v1
CUSTOM_MODEL=gpt-4o-mini

ARK_API_KEY=
ARK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#ARK_MODEL=qwen-plus
ARK_MODEL=qwen3.7-max-2026-05-17
ARK_MODEL_FALLBACKS=qwen3.7-max-preview,qwen3.7-plus-2026-05-26,kimi-k2.6,deepseek-v4-pro,qwen3.6-27b,qwen3.6-flash
RAG_ENABLED=true
RAG_TOP_K=4
RAG_BM25_TOP_K=8
RAG_VECTOR_TOP_K=8
RAG_INDEX_DIR=./data/rag_index

EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
ARK_EMBEDDING_API_KEY=
ARK_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ARK_EMBEDDING_MODEL=text-embedding-v3

# YieldMind local production-stack defaults. Replace these passwords outside development.
YIELDMIND_DATABASE_URL=postgresql+psycopg://yieldmind:yieldmind_dev_only@127.0.0.1:5432/yieldmind
YIELDMIND_REDIS_URL=redis://:yieldmind_redis_dev_only@127.0.0.1:6379/0
YIELDMIND_POSTGRES_PASSWORD=yieldmind_dev_only
YIELDMIND_REDIS_PASSWORD=yieldmind_redis_dev_only
YIELDMIND_TASK_LEASE_SECONDS=30
YIELDMIND_TASK_HEARTBEAT_SECONDS=5
